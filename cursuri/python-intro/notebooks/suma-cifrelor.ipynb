   "source": [
    "# Suma cifrelor unui numar\n",
    "\n",
    "Extragem cifrele cu `% 10` si `// 10`, la fel ca in C++ (doar ca acolo\n",
    "operatorul de impartire intreaga e `/`, nu `//`)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def suma_cifre(n):\n",
    "    s = 0\n",
    "    while n > 0:\n",
    "        s += n % 10\n",
    "        n //= 10\n",
    "    return s\n",
    "\n",
    "suma_cifre(12345)  # 15"
   ]
  }
 ],
