   "source": [
    "# Numararea elementelor pare\n",
    "\n",
    "Parcurgere plus conditie plus contor, un tipar care revine des."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def numara_pare(v):\n",
    "    cnt = 0\n",
    "    for x in v:\n",
    "        if x % 2 == 0:\n",
    "            cnt += 1\n",
    "    return cnt\n",
    "\n",
    "numara_pare([1, 2, 3, 4, 5, 6])  # 3"
   ]
  }
