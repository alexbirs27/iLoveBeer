   "source": [
    "# Suma elementelor unui vector\n",
    "\n",
    "Aceeasi bucla ca in C++, doar ca parcurgem direct elementele\n",
    "(`for x in v`), nu indicii."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def suma(v):\n",
    "    s = 0\n",
    "    for x in v:\n",
    "        s += x\n",
    "    return s\n",
    "\n",
    "suma([1, 2, 3, 4, 5])  # 15"
   ]
  }
 ],
